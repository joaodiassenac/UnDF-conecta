generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum Role {
  ESTUDANTE
  ADMIN
}

enum StatusPublicacao {
  PENDENTE
  EM_ANALISE
  APROVADA
  RESOLVIDA
  REJEITADA
}

enum TipoVoto {
  CURTIDA
}

enum TipoPergunta {
  ESTRELAS
  TEXTO
  MULTIPLA_ESCOLHA
}

//
// USUÁRIOS
//

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  matricula  String   @unique
  email      String?  @unique
  curso      String
  campus     String
  role       Role     @default(ESTUDANTE)

  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  eventosCriados Event[]
  presencas      ConfirmacaoPresenca[]

  publicacoes ForumPost[]
  comentarios ForumComment[]
  votos       ForumVote[]

  avaliacoes Avaliacao[]
}

//
// CALENDÁRIO
//

model CategoriaEvento {
  id        Int    @id @default(autoincrement())
  nome      String @unique
  cor       String

  eventos   Event[]
}

model Event {
  id            Int      @id @default(autoincrement())

  titulo        String
  descricao     String?  @db.Text

  inicio        DateTime
  fim           DateTime

  local         String
  campus        String
  curso         String?

  categoriaId   Int
  categoria     CategoriaEvento @relation(fields: [categoriaId], references: [id])

  criadoPorId   Int
  criadoPor     Usuario @relation(fields: [criadoPorId], references: [id])

  presencas     ConfirmacaoPresenca[]

  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([inicio])
  @@index([categoriaId])
}

model ConfirmacaoPresenca {
  id         Int @id @default(autoincrement())

  eventoId   Int
  usuarioId  Int

  evento      Event    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  confirmadoEm DateTime @default(now())

  @@unique([eventoId, usuarioId])
}

//
// FÓRUM
//

model ForumCategoria {
  id      Int    @id @default(autoincrement())
  nome    String @unique

  posts   ForumPost[]
}

model ForumPost {
  id            Int @id @default(autoincrement())

  titulo        String
  conteudo      String @db.Text

  categoriaId   Int
  categoria      ForumCategoria @relation(fields: [categoriaId], references: [id])

  autorId       Int
  autor         Usuario @relation(fields: [autorId], references: [id])

  status        StatusPublicacao @default(PENDENTE)

  comentarios   ForumComment[]
  votos         ForumVote[]

  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([categoriaId])
  @@index([status])
}

model ForumComment {
  id         Int @id @default(autoincrement())

  conteudo   String @db.Text

  oficial    Boolean @default(false)

  postId      Int
  autorId     Int

  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor       Usuario   @relation(fields: [autorId], references: [id])

  criadoEm    DateTime @default(now())
}

model ForumVote {
  id         Int @id @default(autoincrement())

  tipo       TipoVoto @default(CURTIDA)

  postId     Int
  usuarioId  Int

  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm    DateTime @default(now())

  @@unique([postId, usuarioId])
}

//
// AVALIAÇÃO INSTITUCIONAL
//

model Questionario {
  id          Int @id @default(autoincrement())

  titulo      String
  descricao   String?

  inicio      DateTime
  fim         DateTime

  perguntas   Pergunta[]
  avaliacoes  Avaliacao[]

  criadoEm    DateTime @default(now())
}

model Pergunta {
  id             Int @id @default(autoincrement())

  enunciado      String

  tipo           TipoPergunta

  questionarioId Int

  questionario   Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)

  opcoes         OpcaoPergunta[]

  respostas      Resposta[]
}

model OpcaoPergunta {
  id          Int @id @default(autoincrement())

  texto       String

  perguntaId  Int

  pergunta    Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
}

model Avaliacao {
  id              Int @id @default(autoincrement())

  usuarioId       Int
  questionarioId  Int

  usuario         Usuario @relation(fields: [usuarioId], references: [id])

  questionario    Questionario @relation(fields: [questionarioId], references: [id])

  respostas       Resposta[]

  enviadaEm       DateTime @default(now())

  @@unique([usuarioId, questionarioId])
}

model Resposta {
  id            Int @id @default(autoincrement())

  avaliacaoId   Int
  perguntaId    Int

  nota          Int?
  texto         String? @db.Text
  opcaoId       Int?

  avaliacao     Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  pergunta       Pergunta @relation(fields: [perguntaId], references: [id])

  opcao          OpcaoPergunta? @relation(fields: [opcaoId], references: [id])
}

//
// ENQUETES
//

model Enquete {
  id         Int @id @default(autoincrement())

  pergunta   String

  inicio     DateTime
  fim        DateTime

  opcoes     OpcaoEnquete[]

  criadaEm   DateTime @default(now())
}

model OpcaoEnquete {
  id          Int @id @default(autoincrement())

  texto       String

  votos       Int @default(0)

  enqueteId   Int

  enquete     Enquete @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
}